<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console Skua (no UI). Used by CI to prove Skua.Core + the script compiler work off Windows,
       and usable on Linux/Termux: `skua-headless run --user U --pass P --script path.cs`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>skua-headless</AssemblyName>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Host\Skua.Host.csproj" />
  </ItemGroup>

</Project>
