<Project Sdk="Microsoft.NET.Sdk">

  <!-- Skua without a desktop UI: Skua.Core wired with headless platform services and the
       RemoteFlashUtil transport. Shared by Skua.Headless (console) and Skua.Mobile (Android). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Default data files the desktop app ships next to its exe (Skua.Core expects them). -->
  <ItemGroup>
    <Content Include="..\Skua.App.Avalonia\AdvancedSkills.json" Link="AdvancedSkills.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Skua.App.Avalonia\QuestData.json" Link="QuestData.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Core\Skua.Core.csproj" />
    <ProjectReference Include="..\Skua.Core.Interfaces\Skua.Core.Interfaces.csproj" />
    <ProjectReference Include="..\Skua.Core.Models\Skua.Core.Models.csproj" />
    <ProjectReference Include="..\Skua.Core.Utils\Skua.Core.Utils.csproj" />
    <!-- WinForms stand-in for community scripts (only off Windows; the desktop app never references this). -->
    <ProjectReference Include="..\Skua.WinFormsShim\Skua.WinFormsShim.csproj" />
  </ItemGroup>

</Project>
