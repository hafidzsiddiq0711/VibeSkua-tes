<Project Sdk="Microsoft.NET.Sdk">

  <!-- Skua Mobile: Skua.Core running on the phone (foreground service) and driving
       skua-mobile.swf in the Artix Games Launcher over 127.0.0.1. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <ApplicationId>com.skua.mobile</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- Scripts are compiled at runtime and use reflection over Skua.Core: no trimming, no AOT. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <NoWarn>$(NoWarn);CA1416;CA1422;XA0101</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skua.Host\Skua.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- refs.zip (reference assemblies for the script compiler) is produced by CI. -->
    <AndroidAsset Include="Assets\**\*" Exclude="Assets\README.txt" />
  </ItemGroup>

</Project>
